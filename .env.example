# ─────────────────────────────────────────────────────────────────────────────
# ProSolution Outreach — environment configuration (PLACEHOLDERS ONLY)
#
# 1. Copy this file to `.env` (Windows: `copy .env.example .env`).
# 2. Run `pnpm secrets:generate` and paste the generated values below.
# 3. Never commit `.env`. It is listed in .gitignore.
#
# Nothing in this file is sent to the browser. The web app only receives
# variables prefixed with VITE_, and none are used.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL people open in the browser (the web app). Used for origin checks.
APP_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=4000
# Set to the number of reverse proxies in front of the API in production (e.g. 1 for Caddy). 0 locally.
TRUST_PROXY=0
TZ=Asia/Kolkata

# Secret used to hash session tokens before storing them. 64+ random hex chars.
SESSION_SECRET=replace-with-output-of-pnpm-secrets-generate
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_15_MIN=20
API_RATE_LIMIT_PER_MIN=300

# Human approval before any outbound message. Keep true.
HUMAN_APPROVAL_REQUIRED=true

# ── Local Docker services (used by infra/docker-compose.dev.yml) ─────────────
POSTGRES_USER=prosolution
POSTGRES_PASSWORD=replace-with-a-local-db-password
POSTGRES_DB=prosolution
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Database ─────────────────────────────────────────────────────────────────
# Must match the POSTGRES_* values above when using the local Docker database.
DATABASE_URL=postgresql://prosolution:replace-with-a-local-db-password@localhost:5432/prosolution
# Separate database used only by automated tests. Its name must contain "test".
TEST_DATABASE_URL=postgresql://prosolution:replace-with-a-local-db-password@localhost:5432/prosolution_test

# ── Redis (used from Phase 5 for job queues) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── First admin (optional; only read by `pnpm seed:admin --non-interactive`) ──
# Leave empty to be prompted interactively instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# LATER PHASES — not read by Phase 1. Kept here so the full picture is visible.
# ─────────────────────────────────────────────────────────────────────────────

# Phase 5 — Claude (model IDs verified against platform.claude.com on 2026-10-17;
# re-verify before Phase 5)
# ANTHROPIC_API_KEY=
# AI_PROVIDER=claude            # claude | mock
# CLAUDE_MODEL_ANALYZE=claude-sonnet-5-5
# CLAUDE_MODEL_DRAFT=claude-sonnet-5-5
# CLAUDE_MODEL_VALIDATE=claude-haiku-5-5
# CLAUDE_MODEL_CLASSIFY=claude-haiku-5-5
# AI_DAILY_BUDGET_USD=5

# Phase 7 — Meta / Instagram (official APIs only)
# TOKEN_ENCRYPTION_KEY=          # 32 random bytes, base64
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=
# META_WEBHOOK_VERIFY_TOKEN=
# META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/meta/callback
# INSTAGRAM_MANUAL_DAILY_CAP=20

# Later — Google Places (only after terms/pricing review)
# LEAD_SOURCE_GOOGLE_PLACES_ENABLED=false
# GOOGLE_PLACES_API_KEY=

# Phase 10 — notification email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_FROM=
# NOTIFY_ADMIN_EMAILS=
