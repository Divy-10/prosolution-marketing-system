{
  "name": "@prosolution/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./seed": "./src/seed-config.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "tsx scripts/migrate-test.ts",
    "studio": "prisma studio",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo \"(db) covered by API integration tests\"",
    "check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "seed:config": "tsx scripts/seed-config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@node-rs/argon2": "2.2.1",
    "@prosolution/shared": "workspace:*",
    "dotenv": "17.4.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@types/pg": "8.23.1"
  }
}
